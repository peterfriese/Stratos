{
  "name": "stratos-evals",
  "version": "1.2.0",
  "private": true,
  "description": "Promptfoo evaluation suite for Stratos API design skills",
  "scripts": {
    "eval": "npx promptfoo@0.124.1 eval -c promptfooconfig.yaml",
    "eval:pro": "npx promptfoo@0.124.1 eval -c promptfooconfig.yaml -p vertex:gemini-3.1-pro-preview",
    "eval:core": "npx promptfoo@0.124.1 eval -c promptfooconfig.yaml --filter-metadata skill=stratos-core",
    "eval:swiftui": "npx promptfoo@0.124.1 eval -c promptfooconfig.yaml --filter-metadata skill=stratos-swiftui",
    "eval:swift": "npx promptfoo@0.124.1 eval -c promptfooconfig.yaml --filter-metadata skill=stratos-swift",
    "eval:view": "npx promptfoo@0.124.1 view",
    "eval:validate": "swift -module-cache-path /tmp/stratos-clang-module-cache ../scripts/validate-skills.swift .."
  },
  "devDependencies": {
    "promptfoo": "0.124.1"
  }
}
